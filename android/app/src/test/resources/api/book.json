          "text": "Morning came at last.",
          "start_ms": 990,
          "end_ms": 1450
        },
        {
          "i": 2,
          "p": 1,
          "text": "Everyone was relieved to see the sun.",
          "start_ms": 1450,
          "end_ms": 2420
        },
